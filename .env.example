# Copy to .env.local (ignored by git) to configure local development.

# binder-api base URL, including the version prefix. When set, the app uses the
# API for the catalog, accounts and matching; when unset it keeps its local
# behavior (Scryfall catalog, no accounts).
# Use "localhost" for both the app and the API (not 127.0.0.1): the session
# cookie only travels between same-site origins.
# VITE_API_URL=http://localhost:3000/api/v1

# Dev-only previews with invented data (ignored when VITE_API_URL is set).
# VITE_MOCK_AUTH=1
# VITE_MOCK_WISHERS=1
